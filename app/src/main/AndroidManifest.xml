<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DALEApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DALE">
        <activity
            android:name=".IntroActivity"
            android:exported="true"
            android:theme="@style/Theme.DALE"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DALE"
            android:excludeFromRecents="true">
        </activity>
        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:label="@string/welcome_activity_title"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".AppSelectionActivity"
            android:exported="false"
            android:label="@string/app_selection_activity_title"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".PasswordSetupActivity"
            android:exported="false"
            android:label="@string/password_setup_activity_title"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".GroupSettingsActivity"
            android:exported="false"
            android:label="Group Settings"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".ChangePasswordActivity"
            android:exported="false"
            android:label="Change Password"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".CustomisationActivity"
            android:exported="false"
            android:label="Customisation"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".AppLogsActivity"
            android:exported="false"
            android:label="App Logs"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".ActivityLogsActivity"
            android:exported="false"
            android:label="Activity Logs"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".UsageLogsActivity"
            android:exported="false"
            android:label="Usage Logs"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".DeveloperConsoleActivity"
            android:exported="false"
            android:label="Developer Console"
            android:theme="@style/Theme.DALE" />
        <activity
            android:name=".DrawOverOtherAppsLockScreen"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.DALE" />

        <service
            android:name=".AppMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".MonitorRestartReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Tier 3: Accessibility Service Backend (Universal - ONLY DETECTION METHOD) -->
        <service
            android:name=".DALEAppLockAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Legacy Accessibility Service (DISABLED - use DALEAppLockAccessibilityService instead) -->
        <service
            android:name=".AppLockAccessibilityService"
            android:enabled="false"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
